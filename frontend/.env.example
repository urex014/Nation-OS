# Optional. Defaults work without any credentials. Run commands inside frontend/.
NATIONOS_DB_PATH=data/nigeria/nationos.sqlite
NATIONOS_SOURCE_DIR=data/nigeria/normalized
# Optional public origin for a trusted reverse proxy; comma-separated exact origins.
# NATIONOS_ALLOWED_ORIGINS=https://your-workspace.example

# Session signing secret. Required in production, at least 32 characters.
# Development falls back to a built-in dev-only value when this is unset.
# NATIONOS_SESSION_SECRET=replace-with-a-random-string-at-least-32-chars

# Shared accounts, saved plans, decisions, and audit rows.
# Required for those writes, in local development and on Vercel.
# Neon from the Vercel Marketplace sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED=
# Tables are created on the first request. You do not have to run a script.
# With no URL, sign-up, plans, and decisions return 503. Nothing is saved on
# this computer. Demo sign-in still works.
# DATABASE_URL=postgres://user:password@host/db
# DATABASE_URL_UNPOOLED=postgres://user:password@host/db
# POSTGRES_URL=

# bcrypt cost. Production refuses a value below 12. Tests may set 4.
# NATIONOS_BCRYPT_COST=12

# SQLite file for the main-branch fiscal contract (/api/v1, /api/allocate, chat query).
# NATION_DB_PATH=data/nationos.sqlite

# AI advisor. Optional locally. If XAI_API_KEY is set, calls go to api.x.ai
# (XAI_MODEL, default grok-4.20-non-reasoning). The AI Gateway is used only
# when that key is absent: OIDC on Vercel (Settings → Security → OIDC), or
# AI_GATEWAY_API_KEY. Do not commit a real key.
# Gateway default is spacexai/grok-4.20-non-reasoning. AI_MODEL overrides it.
# AI_MODEL=spacexai/grok-4.20-non-reasoning
# How long a model call may run before the rule-based answer is used. Default 12000.
# AI_TIMEOUT_MS=12000

# Local gateway key from the Vercel AI Gateway dashboard.
# AI_GATEWAY_API_KEY=

# Vercel sends this as the x-vercel-oidc-token request header when
# Project Settings → Security → OIDC is on. Do not create this variable.
# Locally, `vercel env pull` can place a short-lived copy here. Do not commit it.
# VERCEL_OIDC_TOKEN=

# Direct xAI key. When this is set, it is used instead of the AI Gateway.
# XAI_API_KEY=
# XAI_MODEL=grok-4.20-non-reasoning
