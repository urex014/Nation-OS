# Optional. Defaults work without any credentials. Run commands inside frontend/.
NATIONOS_DB_PATH=data/nigeria/nationos.sqlite
NATIONOS_SOURCE_DIR=data/nigeria/normalized
# Optional public origin for a trusted reverse proxy; comma-separated exact origins.
# NATIONOS_ALLOWED_ORIGINS=https://your-workspace.example

# Session signing secret. Required in production, at least 32 characters.
# Development falls back to a built-in dev-only value when this is unset.
# NATIONOS_SESSION_SECRET=replace-with-a-random-string-at-least-32-chars

# Separate from the fiscal database so the account store can be swapped.
# NATIONOS_AUTH_DB_PATH=data/auth.sqlite

# bcrypt cost. Production refuses a value below 12. Tests may set 4.
# NATIONOS_BCRYPT_COST=12

# SQLite file for the main-branch fiscal contract (/api/v1, /api/allocate, chat query).
# NATION_DB_PATH=data/nationos.sqlite

# AI advisor. Optional. If none of the keys below are set, chat stays rule-based.
# The live AI Gateway catalog has no model id "xai/grok-4-fast".
# Default is a fast tool-calling Grok model. AI_MODEL overrides the gateway id.
# AI_MODEL=spacexai/grok-4.20-non-reasoning

# Local gateway key from the Vercel AI Gateway dashboard.
# AI_GATEWAY_API_KEY=

# On a Vercel deployment this is set for you. Do not commit a real token.
# Locally, run `vercel link` and then `vercel env pull`. The token lasts about 12 hours.
# VERCEL_OIDC_TOKEN=

# Direct xAI key. Used only when the gateway key and the OIDC token are both unset.
# XAI_API_KEY=
# XAI_MODEL=grok-4.20-non-reasoning
