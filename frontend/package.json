{
  "name": "nationos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "lint": "eslint app components lib/auth lib/ai lib/nigeria lib/runtime proxy.ts scripts tests",
    "check": "node scripts/check.mjs",
    "check:lines": "node scripts/check-lines.mjs",
    "check:http": "node tests/http.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:init": "tsx scripts/init-db.mjs",
    "data:fetch": "node scripts/nigeria/fetch.mjs",
    "data:normalize": "python scripts/nigeria/normalize.py",
    "test:ui": "tsx --test tests/ui.test.jsx"
  },
  "dependencies": {
    "@ai-sdk/xai": "^5.0.29",
    "ai": "^7.0.152",
    "bcryptjs": "^3.0.3",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "postcss": "^8",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
